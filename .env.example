# Safe placeholders only. Scope and sensitivity for every key are documented in
# docs/environment-variables.md. Copy this file to the ignored .env file for a
# Codespace; Railway variables remain separate and must never be copied here.
APP_ENV=development
DASHBOARD_HOST=127.0.0.1
PORT=8765

KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Sports odds API remains optional; scraper mode is preferred by default.
ODDS_API_KEY=
THE_ODDS_API_KEY=
SPORTSDATA_API_KEY=

# Firecrawl scraper/source snapshots.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=
# optional | required | disabled. Optional is the default and does not lower core quality.
FIRECRAWL_MODE=optional

# PostgreSQL is the only application database. Keep real values in local .env
# or Railway Variables; do not commit credentials or connection strings.
RESEARCH_DATA_DIR=
POSTGRES_USER=hawknetic
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hawknetic
POSTGRES_TEST_DB=hawknetic_test
POSTGRES_PORT=54329
DATABASE_URL=postgresql://hawknetic:change_me@127.0.0.1:54329/hawknetic
TEST_DATABASE_URL=postgresql://hawknetic:change_me@127.0.0.1:54329/hawknetic_test
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_CONNECT_TIMEOUT=5
DATABASE_STATEMENT_TIMEOUT=30000
DATABASE_MIGRATION_STATEMENT_TIMEOUT=300000
DATABASE_MIGRATION_MODE=check
# Evidence gates used by the private readiness report. Set true only after the
# matching staging/backup/volume procedure has been directly verified.
POSTGRES_PARITY_VALIDATED=false
RAILWAY_STAGING_VALIDATED=false
RAILWAY_BACKUP_VERIFIED=false
RAILWAY_VOLUME_HEALTHY=false
RAILWAY_ENVIRONMENT=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_PUBLIC_DOMAIN=
RAILWAY_GIT_COMMIT_SHA=
RAILWAY_REPLICA_ID=

# Hosted public API fetch safety.
# These prevent public Kalshi/ESPN refreshes from hammering sources.
KALSHI_HTTP_CACHE_TTL_SECONDS=900
KALSHI_HTTP_MAX_RETRIES=2
KALSHI_HTTP_BACKOFF_SECONDS=2
KALSHI_HTTP_MIN_INTERVAL_SECONDS=0.25
KALSHI_HTTP_ALLOW_STALE_ON_ERROR=false
KALSHI_HTTP_MAX_STALE_SECONDS=7200
KALSHI_HTTP_MAX_RESPONSE_BYTES=26214400
KALSHI_HTTP_RETRY_JITTER_SECONDS=0.25
SETTLEMENT_MAX_MARKETS_PER_RUN=50
SETTLEMENT_HTTP_TIMEOUT_SECONDS=8
SETTLEMENT_MAX_CONSECUTIVE_FETCH_ERRORS=3
KALSHI_RUNTIME_CLEANUP_ENABLED=true
KALSHI_HTTP_CACHE_MAX_AGE_SECONDS=21600
KALSHI_HTTP_CACHE_MAX_BYTES=268435456
KALSHI_SOURCE_FRESHNESS_SECONDS=1800
KALSHI_PAPER_MAX_PAYLOAD_AGE_SECONDS=1800

# Optional dashboard auth for public Railway/mobile access.
# Local dashboard stays open if DASHBOARD_AUTH_PASSWORD is blank.
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_REQUIRE_AUTH_WHEN_HOSTED=true
DASHBOARD_AUTH_USERNAME=hawknetic
DASHBOARD_AUTH_PASSWORD=
DASHBOARD_BASIC_FALLBACK_ENABLED=true
DASHBOARD_BASIC_AUTH_ROLE=admin
DASHBOARD_USER_AUTH_ENABLED=false
DASHBOARD_PAYLOAD_SOURCE=postgres
DASHBOARD_REFRESH_SECONDS=300
AUTH_SESSION_MINUTES=480
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
AUTH_REGISTRATION_ENABLED=false
# Used only for one local auth-create-user invocation; remove it immediately afterward.
AUTH_NEW_USER_PASSWORD=

# Private operator/Codex instruction inbox. This queue stores messages for manual
# review only; it never executes commands, edits code, deploys, or trades.
OPERATOR_NAME=owner
DASHBOARD_MAX_SLIP_AGE_SECONDS=1800

# Optional Google Drive report/archive connector.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_REPORT_FOLDER="Research Bots"

# Optional Airtable operational status connector.
AIRTABLE_ENABLED=false
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_BOT_RUNS_TABLE="Bot Runs"
AIRTABLE_SOURCE_HEALTH_TABLE="Source Health"
AIRTABLE_STAGE_GATES_TABLE="Stage Gates"
AIRTABLE_OPEN_ISSUES_TABLE="Open Issues"

# Optional Slack alert connector.
SLACK_ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=

# Private sports source collection.
SPORTS_SOURCE_MODE=scraper
SPORTS_SCRAPER_ENABLED=true
# Ordered by the controlled retrieval priority. Unconfigured methods are skipped.
SPORTS_RETRIEVAL_PLAN=official_api,http_json,firecrawl
SPORTS_SOURCE_TIMEOUT_SECONDS=8
SPORTS_MAX_SUMMARY_REQUESTS=16
SPORTS_FINALS_LOOKBACK_DAYS=2

# Source catalog collection limits and always-on worker cadence.
KALSHI_PLAYER_TARGET_TYPES=
KALSHI_PLAYER_PAGE_SIZE=1000
KALSHI_MILESTONE_PAGE_SIZE=200
KALSHI_EVENT_METADATA_LIMIT=25
KALSHI_LIVE_MILESTONE_LIMIT=25
KALSHI_REFERENCE_CADENCE_SECONDS=21600
POLYMARKET_COLLECTION_CADENCE_SECONDS=3600
POLYMARKET_SPORTS_PAGE_SIZE=250
POLYMARKET_SPORTS_PAGES=2
POLYMARKET_TEAM_PAGE_SIZE=500
POLYMARKET_TEAM_PAGES=10
SOURCE_REFRESH_MAX_REQUESTS=5
SOURCE_REFRESH_POLL_SECONDS=30

# Raw evidence retention. Hosted values require a reviewed readiness gate; dev
# data may be discarded with local.sh db-reset.
#
# The window is arithmetic, not taste: it sets the table's steady-state size as
# `daily_growth x window_days`. Production measured ~166 MB/day of raw payloads
# against a 5 GB volume, so 45 days was never reachable -- nothing ever aged
# into eligibility, retention pruned nothing, and the volume filled to 100% and
# took PostgreSQL down on 2026-09-01. Ten days is the setting production proved.
# Recompute from your own volume size and measured growth before widening it.
RAW_RETENTION_DAYS=10
RAW_RETENTION_BATCH_LIMIT=5000
RAW_RETENTION_DRY_RUN=true
RAW_RETENTION_DUPLICATION_CENSUS=false

# The volume ceiling the database runs against, used to alarm before it fills.
# Warning at 75%, critical at 90%. Railway's Hobby plan provisions (and caps)
# 5 GB volumes; raise this after a resize or a move to a larger plan.
DATABASE_VOLUME_CAPACITY_BYTES=5000000000

# Private always-on local scheduler/watchdog.
RESEARCH_DAEMON_ENABLED=false
RESEARCH_DASHBOARD_PORT=8765
CRYPTO_RUN_ID=crypto_private_20260704
SPORTS_RUN_ID=sports_private_20260704
KALSHI_RUN_ID=stage3a_20260703_170707
BOT_COMPANY_ENABLED=true
EXTERNAL_SOURCES_CONFIG=config/sources.json
HAWKNETIC_SERVICE=web
# loop: always-on worker using its own cadence. once: run a single cycle and
# exit, so the worker can be a scheduled scale-to-zero Railway cron service.
HAWKNETIC_SERVICE_MODE=loop

# Optional: develop with no Docker daemon by pointing scripts/local.sh at a
# managed development database (for example two Neon branches) instead of
# compose.yml. Set BOTH or neither, and never point either at production.
HAWKNETIC_DATABASE_URL=
HAWKNETIC_TEST_DATABASE_URL=
HAWKNETIC_ALLOW_HOSTED_DATABASE=

# Authenticated account handoff remains disabled.
KALSHI_ORDER_UPLOAD_ENABLED=false
RESEARCH_ONLY=true
LIVE_EXECUTION_ENABLED=false
AUTO_UPLOAD_ENABLED=false
AUTO_TRADE_ENABLED=false
MODEL_PROMOTION_ENABLED=false
STALE_CACHE_AS_FRESH=false

# Explicitly disabled public/product connectors for now.
VERCEL_ENABLED=false
POSTHOG_ENABLED=false
STRIPE_ENABLED=false
