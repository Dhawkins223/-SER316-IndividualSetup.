__pycache__/
*.py[cod]
*.egg-info/
# `pip wheel .` and `python -m build` leave a full copy of the package here.
# CI builds a wheel on every run, so an ignored build tree is the difference
# between a reviewable diff and 40,000 lines of duplicated source.
build/
dist/
*.whl
.pytest_cache/
.venv/
data/*.log
data/daemon/*.log
data/*
!data/.gitkeep
.env
.env.*
!.env.example
*.pem
*.key
*.p8
data/secrets/
.railway/
*.sqlit[e]
*.sqlit[e]3
*.d[b]

# Terraform. The provider cache is hundreds of MB and per-directory; state and
# backend config are environment-specific and may name the AWS account.
**/.terraform/
*.tfstate
*.tfstate.*

# Dependency locks belong to root modules, and the three roots (bootstrap, dev,
# prod) commit theirs. A lock file under modules/ is a by-product of validating
# that module standalone -- which CI and the bootstrap script both do -- and
# committing one pins a child module independently of the roots that use it.
infrastructure/aws/modules/*/.terraform.lock.hcl
*.tfvars
!*.tfvars.example
backend.hcl
crash.log
